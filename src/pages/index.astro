---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PontoColeta from "../components/PontoColeta.astro";
import GuiaPodeNaoPode from "../components/GuiaPodeNaoPode.astro";
import Avaliacao from "../components/Avaliacao.astro";
import Secao from "../components/Secao.astro";
// Marcadores do plano do MVP (docs/sdd/03-plano-tarefas.md, seção 1.2): cada tarefa troca só o seu.
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";

// T-03: import CicloResiduo

const secoes = (
  await getCollection("secoes", ({ data }) => data.publicada)
).sort((a, b) => a.data.ordem - b.data.ordem);
---

<BaseLayout
  title="SocialTech: descarte correto de resíduos orgânicos"
  description="Projeto de extensão da UCB em parceria com o Projeto Enactus."
>
  <Cabecalho />
  <main>
    <GuiaPodeNaoPode />

    <PontoColeta />

    {/* T-03: <CicloResiduo /> */}

    <Avaliacao />

    {secoes.map((secao) => (
      <Secao secao={secao} />
    ))}
  </main>
  <Rodape />
</BaseLayout>
