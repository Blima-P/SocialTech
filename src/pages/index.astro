---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PontoColeta from "../components/PontoColeta.astro";
import GuiaPodeNaoPode from "../components/GuiaPodeNaoPode.astro";
import Avaliacao from "../components/Avaliacao.astro";
import Secao from "../components/Secao.astro";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";
import CicloResiduo from "../components/CicloResiduo.astro";
import NumerosImpacto from "../components/NumerosImpacto.astro";
import Quiz from "../components/Quiz.astro";

const secoes = (
  await getCollection("secoes", ({ data }) => data.publicada)
).sort((a, b) => a.data.ordem - b.data.ordem);
---

<BaseLayout
  title="SocialTech: descarte correto de resíduos orgânicos"
  description="O que pode ir na lixeira de compostagem da UCB, para onde vai o resíduo e onde a lixeira está. Projeto de extensão da UCB com o Projeto Enactus."
>
  <Cabecalho />
  <main>
    <GuiaPodeNaoPode />

    <PontoColeta />

    <CicloResiduo />

    <NumerosImpacto />

    <Quiz />

    <Avaliacao />

    {secoes.map((secao) => (
      <Secao secao={secao} />
    ))}
  </main>
  <Rodape />
</BaseLayout>
