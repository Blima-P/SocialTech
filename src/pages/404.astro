---
import BaseLayout from "../layouts/BaseLayout.astro";
import Rodape from "../components/Rodape.astro";

// O GitHub Pages mostra esta página em qualquer endereço que não existe dentro de
// /SocialTech/. Por isso os links usam o BASE_URL completo, e não "#guia".
const inicio = import.meta.env.BASE_URL;
const atalhos = [
  { texto: "O que pode ir na lixeira", ancora: "guia" },
  { texto: "Onde está a lixeira", ancora: "ponto-de-coleta" },
  { texto: "Do resto de comida à horta", ancora: "ciclo" },
];
---

<BaseLayout
  title="Página não encontrada · SocialTech"
  description="Este endereço não existe no site SocialTech."
  erro
>
  <main>
    <section aria-labelledby="titulo-erro">
      <p class="selo">Erro 404</p>
      <h1 id="titulo-erro">Página não encontrada</h1>
      <p>
        O endereço pode estar incompleto. O site do SocialTech tem uma página
        só, com tudo sobre o descarte de resíduos orgânicos.
      </p>
      <a class="voltar" href={inicio}>
        Ir para o início
      </a>
      <h2 id="titulo-atalhos">Ou vá direto para</h2>
      <ul aria-labelledby="titulo-atalhos">
        {atalhos.map(({ texto, ancora }) => (
          <li>
            <a href={`${inicio}#${ancora}`}>{texto}</a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Rodape />
</BaseLayout>

<style>
  /* Só nesta página: a faixa amarela cresce até o rodapé ficar no fim da tela. */
  :global(body) {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  main {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  main > section {
    flex: 1;
    border-top: 0.25rem solid var(--cor-destaque);
    background: var(--cor-destaque);
  }

  main > section > * {
    max-width: var(--largura-conteudo);
  }

  .selo {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.25rem 0 var(--espaco);
    font-size: clamp(2rem, 1.5rem + 3vw, 3.25rem);
    line-height: 1.1;
  }

  h2 {
    margin: calc(var(--espaco) * 2) 0 0.5rem;
    font-size: 1.125rem;
  }

  h2::after {
    display: none;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--alvo-toque);
    color: var(--cor-texto);
    font-weight: 700;
  }

  a:focus-visible {
    outline-color: var(--cor-escura);
  }

  .voltar {
    padding-inline: 1.25rem;
    border-radius: var(--raio);
    background: var(--cor-escura);
    color: var(--cor-fundo);
    text-decoration: none;
  }
</style>
