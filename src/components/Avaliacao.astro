---
import { getEntry } from "astro:content";

const formulario = await getEntry("avaliacao", "formulario");
const endereco = formulario?.data.endereco;
---

{endereco && (
  <section id="avaliacao" aria-labelledby="titulo-avaliacao">
    <h2 id="titulo-avaliacao">Avalie o projeto</h2>
    <p>{formulario.data.texto}</p>
    <a class="botao" href={endereco} target="_blank" rel="noopener">
      Responder o formulário
      <span class="visualmente-oculto"> (abre em nova aba)</span>
    </a>
  </section>
)}

<style>
  section {
    background: var(--cor-destaque);
  }

  /* Na faixa amarela, o traço do título e o contorno de foco ficam escuros. */
  h2::after {
    background: var(--cor-escura);
  }

  .botao:focus-visible {
    outline-color: var(--cor-escura);
  }
</style>
