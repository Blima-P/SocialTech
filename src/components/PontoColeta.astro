---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";

const ponto = await getEntry("pontoColeta", "atual");
if (!ponto) {
  throw new Error("src/content/ponto-coleta.json não encontrado.");
}
const { local, comoReconhecer, atualizadoEm, imagem, descricaoImagem } =
  ponto.data;
const dataFormatada = new Intl.DateTimeFormat("pt-BR", {
  timeZone: "UTC",
}).format(atualizadoEm);
const dataIso = atualizadoEm.toISOString().slice(0, 10);
---

<section id="ponto-de-coleta" aria-labelledby="titulo-ponto">
  <h2 id="titulo-ponto">Onde está a lixeira agora</h2>
  <p class="local">{local}</p>
  {imagem && (
    <Image
      class="foto"
      src={imagem}
      alt={descricaoImagem ?? ""}
      widths={[360, 720]}
      width={720}
      quality={70}
      sizes="(min-width: 48rem) 21rem, 100vw"
    />
  )}
  <p>{comoReconhecer}</p>
  <p class="atualizacao">
    Atualizado em <time datetime={dataIso}>{dataFormatada}</time>
  </p>
</section>

<style>
  section {
    background: var(--cor-fundo-suave);
  }

  .local {
    max-width: var(--largura-conteudo);
    margin: 0;
    border-left: 0.375rem solid var(--cor-destaque);
    border-radius: var(--raio);
    padding: var(--espaco);
    background: var(--cor-fundo);
    font-size: 1.25rem;
    font-weight: 700;
  }

  /* Fotos em pé (3:4) ficam com no máximo 28rem de altura, sem cortar. */
  .foto {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 28rem;
    height: auto;
    margin-top: var(--espaco);
    border-radius: var(--raio);
  }

  .atualizacao {
    color: var(--cor-texto-suave);
  }
</style>
