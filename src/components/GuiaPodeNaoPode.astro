---
import { getCollection, getEntry } from "astro:content";

const itens = (await getCollection("guia")).sort(
  (a, b) => Number(a.id) - Number(b.id),
);
const pode = itens.filter(({ data }) => data.classificacao === "pode");
const naoPode = itens.filter(({ data }) => data.classificacao === "nao-pode");
const naoListado = (await getEntry("guiaOrientacao", "atual"))?.data.naoListado;
---

<section id="guia" aria-labelledby="titulo-guia" data-guia>
  <h2 id="titulo-guia">O que pode ir nesta lixeira?</h2>
  <div class="busca" hidden data-busca>
    <label for="busca-guia">Procure um item</label>
    <input id="busca-guia" type="search" autocomplete="off" />
    <p class="contagem" aria-live="polite" data-contagem></p>
  </div>
  <div class="grupos">
    <div class="grupo grupo--pode">
      <h3>
        <span aria-hidden="true">✓</span> Pode
      </h3>
      {pode.length > 0 ? (
        <ul>
          {pode.map(({ data }) => (
            <li class="cartao">
              <strong>{data.nome}</strong>
              <p>{data.motivo}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p>Lista do que pode ir na lixeira em validação com a Enactus.</p>
      )}
    </div>
    <div class="grupo grupo--nao-pode">
      <h3>
        <span aria-hidden="true">✕</span> Não pode
      </h3>
      <ul>
        {naoPode.map(({ data }) => (
          <li class="cartao">
            <strong>{data.nome}</strong>
            <p>{data.motivo}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <aside class="nao-listado" aria-labelledby="titulo-nao-listado">
    <h3 id="titulo-nao-listado">Não achou seu item?</h3>
    <p>
      {naoListado ??
        "Orientação para itens fora da lista em validação com a Enactus."}
    </p>
  </aside>
</section>

<script>
  // Busca local: o que é digitado não é guardado nem enviado.
  const semAcento = (texto: string) =>
    texto
      .normalize("NFD")
      .replace(/\p{Diacritic}/gu, "")
      .toLowerCase()
      .trim();

  for (const guia of document.querySelectorAll<HTMLElement>("[data-guia]")) {
    const busca = guia.querySelector<HTMLElement>("[data-busca]")!;
    const campo = busca.querySelector("input")!;
    const contagem = guia.querySelector<HTMLElement>("[data-contagem]")!;
    const cartoes = [...guia.querySelectorAll<HTMLElement>(".cartao")];
    const textos = cartoes.map((cartao) =>
      semAcento(cartao.querySelector("strong")?.textContent ?? ""),
    );
    const grupos = [...guia.querySelectorAll<HTMLElement>(".grupo")];
    busca.hidden = false;

    campo.addEventListener("input", () => {
      const termo = semAcento(campo.value);
      let achados = 0;
      cartoes.forEach((cartao, indice) => {
        const mostra = textos[indice].includes(termo);
        cartao.hidden = !mostra;
        if (mostra) achados += 1;
      });
      for (const grupo of grupos) {
        grupo.hidden =
          termo.length > 0 &&
          grupo.querySelectorAll(".cartao:not([hidden])").length === 0;
      }
      if (!termo) contagem.textContent = "";
      else if (achados === 0) contagem.textContent = "Nenhum item encontrado.";
      else
        contagem.textContent =
          achados === 1
            ? "1 item encontrado."
            : `${achados} itens encontrados.`;
    });
  }
</script>

<style>
  .grupos {
    display: grid;
    gap: 0.75rem;
  }

  .busca {
    max-width: var(--largura-conteudo);
    margin-bottom: var(--espaco);
  }

  .busca label {
    display: block;
    margin-bottom: 0.25rem;
    font-weight: 700;
  }

  .busca input {
    width: 100%;
    min-height: var(--alvo-toque);
    border: 2px solid var(--cor-texto-suave);
    border-radius: var(--raio);
    padding-inline: 0.75rem;
    font: inherit;
  }

  .contagem {
    margin: 0.25rem 0 0;
    color: var(--cor-texto-suave);
  }

  .contagem:empty {
    display: none;
  }

  .nao-listado {
    max-width: var(--largura-conteudo);
    margin-top: var(--espaco);
    border-radius: var(--raio);
    padding: 0.75rem var(--espaco);
    background: var(--cor-fundo-suave);
  }

  .nao-listado h3 {
    margin: 0;
  }

  .nao-listado p {
    margin: 0.25rem 0 0;
  }

  .grupo h3 {
    margin: 0 0 0.375rem;
  }

  .grupo--pode h3 {
    color: var(--cor-pode);
  }

  .grupo--nao-pode h3 {
    color: var(--cor-nao-pode);
  }

  ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cartao {
    border-left: 0.25rem solid var(--cor-pode);
    border-radius: var(--raio);
    padding: 0.5rem 0.75rem;
    background: var(--cor-pode-fundo);
  }

  .grupo--nao-pode .cartao {
    border-left-color: var(--cor-nao-pode);
    background: var(--cor-nao-pode-fundo);
  }

  .cartao p,
  .grupo > p {
    margin: 0.125rem 0 0;
    color: var(--cor-texto-suave);
  }

  @media (min-width: 48rem) {
    .grupos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--espaco);
    }
  }
</style>
