---
import { Image } from "astro:assets";
import logo from "../assets/marca/logo-enactus-brasil.svg";
import logoEscuro from "../assets/marca/logo-enactus-brasil-footer.svg";

const atalhos = [
  { texto: "Ciclo do resíduo", ancora: "#ciclo" },
  { texto: "O que pode", ancora: "#guia" },
  { texto: "Onde está a lixeira", ancora: "#ponto-de-coleta" },
];
---

<header id="topo">
  <div class="barra">
    <Image
      class="logo-claro"
      src={logo}
      alt="Enactus Brasil"
      height={40}
      loading="eager"
    />
    <Image
      class="logo-escuro"
      src={logoEscuro}
      alt="Enactus Brasil"
      height={40}
      loading="eager"
    />
    <nav aria-label="Seções da página">
      <ul>
        {atalhos.map(({ texto, ancora }) => (
          <li>
            <a href={ancora}>{texto}</a>
          </li>
        ))}
      </ul>
    </nav>
    {/* Sem JavaScript o botão fica escondido e o tema segue o do sistema (RF-17, RNF-10). */}
    <button
      class="tema"
      type="button"
      aria-pressed="false"
      title="Modo escuro"
      data-alternar-tema
      hidden
    >
      <svg class="lua" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7Z" />
      </svg>
      <svg class="sol" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" />
      </svg>
      <span class="visualmente-oculto">Modo escuro</span>
    </button>
  </div>
  <div class="destaque tema-fixo-claro">
    <p class="selo">Projeto de extensão UCB + Enactus</p>
    <h1>Compostagem Enactus UCB</h1>
    <p class="frase">Descarte correto de resíduos orgânicos</p>
    <a class="botao" href="#guia">
      O que pode ir na lixeira?
    </a>
  </div>
</header>

<script>
  // RF-17: alterna o tema e guarda só a escolha ("claro" ou "escuro") neste navegador (RNF-12).
  const botao = document.querySelector<HTMLButtonElement>(
    "[data-alternar-tema]",
  );

  if (botao) {
    const raiz = document.documentElement;
    const sistemaEscuro = window.matchMedia("(prefers-color-scheme: dark)");
    const temaAtual = () =>
      raiz.dataset.tema ?? (sistemaEscuro.matches ? "escuro" : "claro");
    const mostrar = () =>
      botao.setAttribute("aria-pressed", String(temaAtual() === "escuro"));

    botao.addEventListener("click", () => {
      const novo = temaAtual() === "escuro" ? "claro" : "escuro";
      raiz.dataset.tema = novo;
      try {
        localStorage.setItem("tema", novo);
      } catch {
        // Armazenamento bloqueado: a escolha vale só nesta visita.
      }
      mostrar();
    });
    sistemaEscuro.addEventListener("change", mostrar);
    mostrar();
    botao.hidden = false;
  }
</script>

<style>
  header {
    border-top: 0.25rem solid var(--cor-destaque);
    background: var(--cor-fundo);
  }

  /* No celular o menu quebra para uma faixa própria abaixo do logo. */
  .barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem var(--espaco);
    padding: 0.625rem var(--recuo-lateral) 0.25rem;
  }

  .barra img {
    width: auto;
    height: 2.25rem;
  }

  .logo-claro {
    display: var(--exibir-no-claro);
  }

  .logo-escuro {
    display: var(--exibir-no-escuro);
  }

  .tema {
    display: inline-grid;
    place-items: center;
    width: var(--alvo-toque);
    height: var(--alvo-toque);
    border: 2px solid var(--cor-borda);
    border-radius: 50%;
    padding: 0;
    background: var(--cor-fundo);
    color: var(--cor-texto);
    cursor: pointer;
  }

  .tema[hidden] {
    display: none;
  }

  .tema:hover {
    border-color: var(--cor-destaque);
  }

  .tema svg {
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: currentcolor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  /* Mostra o tema para onde o botão leva: lua no claro, sol no escuro. */
  .tema[aria-pressed="true"] .lua,
  .tema[aria-pressed="false"] .sol {
    display: none;
  }

  /* Faixa horizontal sem JavaScript: se os links não couberem, só ela rola de lado. */
  nav {
    order: 1;
    width: 100%;
    overflow-x: auto;
  }

  nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--alvo-toque);
    padding-inline: 0.75rem;
    color: var(--cor-texto);
    font-size: 0.9375rem;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
  }

  nav li:first-child a {
    padding-inline-start: 0;
  }

  /* Contorno por dentro do link, para a rolagem da faixa não cortá-lo. */
  nav a:focus-visible {
    outline-offset: -3px;
  }

  nav a:hover {
    box-shadow: inset 0 -0.1875rem 0 var(--cor-destaque);
  }

  /* Faixa amarela com o recorte diagonal escuro da identidade Enactus. */
  .destaque {
    position: relative;
    overflow: hidden;
    padding: calc(var(--espaco) * 1.5) var(--recuo-lateral);
    background: var(--cor-destaque);
    color: var(--cor-texto);
  }

  .destaque > * {
    position: relative;
    z-index: 1;
    max-width: 34rem;
  }

  .selo {
    margin: 0 0 0.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.5rem + 4vw, 4rem);
    line-height: 1.05;
  }

  .frase {
    margin: 0.5rem 0 var(--espaco);
    font-size: clamp(1.0625rem, 1rem + 0.6vw, 1.375rem);
  }

  .botao {
    padding-inline: 1.25rem;
  }

  .botao:focus-visible {
    outline-color: var(--cor-escura);
  }

  @media (min-width: 48rem) {
    .barra {
      flex-wrap: nowrap;
      padding-bottom: 0.625rem;
    }

    nav {
      order: 0;
      width: auto;
      margin-left: auto;
      overflow-x: visible;
    }

    nav a:focus-visible {
      outline-offset: 2px;
    }

    nav li:first-child a {
      padding-inline-start: 0.75rem;
    }

    .destaque {
      padding-block: calc(var(--espaco) * 4.5);
    }

    /* Recorte diagonal escuro à direita, só decorativo. */
    .destaque::before {
      content: "";
      position: absolute;
      inset: 0 0 0 auto;
      width: 45%;
      background: var(--cor-escura);
      clip-path: polygon(35% 0, 100% 0, 100% 100%, 0 100%);
    }
  }
</style>
