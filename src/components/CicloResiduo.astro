---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

// O id é a posição na lista do painel; ordenar por ele mantém a ordem definida lá.
const etapas = (await getCollection("ciclo")).sort(
  (a, b) => Number(a.id) - Number(b.id),
);
const semDescricao = etapas.every(({ data }) => !data.descricao);
---

<section id="ciclo" aria-labelledby="titulo-ciclo" data-ciclo>
  <h2 id="titulo-ciclo">Do resto de comida à horta</h2>
  {semDescricao && <p>Textos do ciclo em validação com a Enactus.</p>}
  <p class="dica-arraste" hidden data-dica-arraste>
    Arraste para o lado para ver as próximas etapas.
  </p>
  <ol class="atalhos" aria-label="Escolha uma etapa" hidden data-atalhos>
    {etapas.map(({ data }, indice) => (
      <li>
        <button type="button" aria-label={`Etapa ${indice + 1}: ${data.nome}`}>
          {indice + 1}
        </button>
      </li>
    ))}
  </ol>
  <ol class="etapas">
    {etapas.map(({ data }, indice) => (
      <li>
        <span class="numero" aria-hidden="true">
          {indice + 1}
        </span>
        <div>
          <p class="nome">{data.nome}</p>
          {data.descricao && <p class="descricao">{data.descricao}</p>}
          {data.imagem && (
            <Image
              class="foto"
              src={data.imagem}
              alt={data.descricaoImagem ?? ""}
              widths={[320, 576]}
              width={576}
              quality={55}
              sizes="(min-width: 48rem) 21rem, 100vw"
            />
          )}
        </div>
        {indice < etapas.length - 1 && <span class="seta" aria-hidden="true" />}
      </li>
    ))}
  </ol>
  <div class="navegacao" hidden data-navegacao>
    <button type="button" data-anterior>
      Anterior
    </button>
    <p aria-live="polite" data-posicao></p>
    <button type="button" data-proxima>
      Próxima
    </button>
  </div>
</section>

<script>
  import { exigir } from "../scripts/exigir";

  // Sem JavaScript, a lista mostra todas as etapas. No celular, o modo interativo permite arrastar.
  for (const ciclo of document.querySelectorAll<HTMLElement>("[data-ciclo]")) {
    const lista = exigir<HTMLOListElement>(ciclo, ".etapas");
    const etapas = [...ciclo.querySelectorAll<HTMLElement>(".etapas > li")];
    const atalhos = [
      ...ciclo.querySelectorAll<HTMLButtonElement>("[data-atalhos] button"),
    ];
    const anterior = exigir<HTMLButtonElement>(ciclo, "[data-anterior]");
    const proxima = exigir<HTMLButtonElement>(ciclo, "[data-proxima]");
    const posicao = exigir(ciclo, "[data-posicao]");
    const modoCarrossel = window.matchMedia("(max-width: 63.999rem)");
    const movimentoReduzido = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    if (etapas.length < 2) continue;

    const mostrar = (ativa: number) => {
      etapas.forEach(
        (etapa, indice) =>
          (etapa.hidden = !modoCarrossel.matches && indice !== ativa),
      );
      atalhos.forEach((botao, indice) =>
        indice === ativa
          ? botao.setAttribute("aria-current", "step")
          : botao.removeAttribute("aria-current"),
      );
      anterior.disabled = ativa === 0;
      proxima.disabled = ativa === etapas.length - 1;
      const nome = etapas[ativa]?.querySelector(".nome")?.textContent;
      posicao.textContent = `Etapa ${ativa + 1} de ${etapas.length}: ${nome}`;
    };

    let atual = 0;
    let alvoProgramatico: number | null = null;
    let temporizadorRolagem = 0;
    const cancelarRolagemProgramatica = () => {
      alvoProgramatico = null;
      window.clearTimeout(temporizadorRolagem);
    };
    const esquerdaDaEtapa = (indice: number) =>
      etapas[indice].offsetLeft - lista.offsetLeft;
    const ir = (indice: number, rolar = true) => {
      atual = Math.min(Math.max(indice, 0), etapas.length - 1);
      mostrar(atual);
      if (modoCarrossel.matches && rolar) {
        const esquerda = esquerdaDaEtapa(atual);
        const suave = !movimentoReduzido.matches;
        cancelarRolagemProgramatica();
        if (suave && Math.abs(lista.scrollLeft - esquerda) > 1) {
          alvoProgramatico = atual;
          temporizadorRolagem = window.setTimeout(
            cancelarRolagemProgramatica,
            1500,
          );
        }
        lista.scrollTo({
          left: esquerda,
          behavior: suave ? "smooth" : "auto",
        });
      }
    };

    atalhos.forEach((botao, indice) => {
      botao.addEventListener("click", () => ir(indice));
      // Setas, Home e End só movem o foco; Enter ou Espaço escolhem a etapa.
      botao.addEventListener("keydown", (evento) => {
        const destino = {
          ArrowRight: indice + 1,
          ArrowLeft: indice - 1,
          Home: 0,
          End: atalhos.length - 1,
        }[evento.key];
        if (destino === undefined) return;
        evento.preventDefault();
        atalhos[Math.min(Math.max(destino, 0), atalhos.length - 1)].focus();
      });
    });
    anterior.addEventListener("click", () => ir(atual - 1));
    proxima.addEventListener("click", () => ir(atual + 1));
    lista.addEventListener("pointerdown", cancelarRolagemProgramatica, {
      passive: true,
    });
    lista.addEventListener("touchstart", cancelarRolagemProgramatica, {
      passive: true,
    });
    lista.addEventListener("wheel", cancelarRolagemProgramatica, {
      passive: true,
    });

    let quadroRolagem = 0;
    lista.addEventListener(
      "scroll",
      () => {
        if (!modoCarrossel.matches) return;
        cancelAnimationFrame(quadroRolagem);
        quadroRolagem = requestAnimationFrame(() => {
          const esquerda = lista.scrollLeft;
          if (alvoProgramatico !== null) {
            if (Math.abs(esquerda - esquerdaDaEtapa(alvoProgramatico)) <= 1) {
              cancelarRolagemProgramatica();
            }
            return;
          }
          const maisProxima = etapas.reduce(
            (melhor, etapa, indice) => {
              const distancia = Math.abs(
                etapa.offsetLeft - lista.offsetLeft - esquerda,
              );
              return distancia < melhor.distancia
                ? { indice, distancia }
                : melhor;
            },
            { indice: 0, distancia: Number.POSITIVE_INFINITY },
          );
          if (maisProxima.indice !== atual) ir(maisProxima.indice, false);
        });
      },
      { passive: true },
    );

    modoCarrossel.addEventListener("change", () => {
      cancelarRolagemProgramatica();
      ir(atual, false);
    });
    ciclo.classList.add("interativo");
    exigir(ciclo, "[data-atalhos]").hidden = false;
    exigir(ciclo, "[data-navegacao]").hidden = false;
    exigir(ciclo, "[data-dica-arraste]").hidden = false;
    ir(0);
  }
</script>
<style>
  /* Celular e tablet: uma etapa abaixo da outra, com seta ↓. Computador: em linha, com seta →. */
  .etapas {
    display: flex;
    flex-direction: column;
    gap: calc(var(--espaco) * 2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .etapas > li {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--espaco);
    border-radius: var(--raio);
    padding: var(--espaco);
    background: var(--cor-fundo-suave);
  }

  /* O número é repetido visualmente; o leitor de tela já anuncia a posição pela <ol>. */
  .numero {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--cor-destaque);
    color: var(--cor-sobre-destaque);
    font-weight: 700;
  }

  /* Ocupa o resto da linha, para a foto não estourar a largura do cartão. */
  .etapas > li > div {
    flex: 1;
    width: 100%;
    min-width: 0;
  }

  .etapas > li:has(.foto) {
    align-items: flex-start;
  }

  .foto {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
    margin-top: 0.5rem;
    border-radius: var(--raio);
  }

  .dica-arraste {
    margin: 0 0 var(--espaco);
    color: var(--cor-texto-suave);
  }

  .dica-arraste[hidden] {
    display: none;
  }

  .nome {
    margin: 0;
    font-weight: 700;
  }

  .descricao {
    margin: calc(var(--espaco) / 4) 0 0;
    color: var(--cor-texto-suave);
  }

  .seta {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    color: var(--cor-texto-suave);
    font-size: 1.5rem;
    line-height: calc(var(--espaco) * 2);
  }

  .seta::before {
    content: "↓";
  }

  @media (min-width: 64rem) {
    .interativo .dica-arraste {
      display: none;
    }

    .etapas {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }

    .etapas > li {
      flex-direction: column;
      align-items: flex-start;
    }

    .seta {
      top: 50%;
      left: 100%;
      width: calc(var(--espaco) * 2);
      transform: translateY(-50%);
      text-align: center;
    }

    .seta::before {
      content: "→";
    }
  }
  /* Modo passo a passo (só com JavaScript). */
  .etapas > li[hidden] {
    display: none;
  }

  .interativo .etapas {
    display: block;
    max-width: var(--largura-conteudo);
  }

  .interativo .etapas > li {
    min-height: 7rem;
  }

  .interativo .seta {
    display: none;
  }

  @media (max-width: 63.999rem) {
    .interativo .etapas {
      display: flex;
      flex-direction: row;
      max-width: none;
      gap: 0.75rem;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      padding-bottom: 0.5rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
    }

    .interativo .etapas > li {
      box-sizing: border-box;
      flex: 0 0 calc(100% - 2.5rem);
      min-width: 0;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
  }

  .atalhos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 var(--espaco);
    padding: 0;
    list-style: none;
  }

  .atalhos[hidden],
  .navegacao[hidden] {
    display: none;
  }

  button {
    min-width: var(--alvo-toque);
    min-height: var(--alvo-toque);
    border: 2px solid var(--cor-escura);
    border-radius: var(--raio);
    padding-inline: 0.75rem;
    background: var(--cor-fundo);
    color: var(--cor-texto);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .atalhos button[aria-current="step"] {
    background: var(--cor-destaque);
    color: var(--cor-sobre-destaque);
  }

  /* Desabilitado continua com cara de botão: contorno tracejado e fundo próprio. */
  button:disabled {
    border-style: dashed;
    border-color: var(--cor-texto-suave);
    background: var(--cor-fundo-suave);
    color: var(--cor-texto-suave);
    cursor: default;
  }

  .navegacao {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espaco);
    max-width: var(--largura-conteudo);
    margin-top: var(--espaco);
  }

  /* O texto da etapa pode ser longo: quem encolhe é ele, não os botões. */
  .navegacao button {
    flex-shrink: 0;
  }

  .navegacao p {
    margin: 0;
    text-align: center;
    color: var(--cor-texto-suave);
  }
</style>
