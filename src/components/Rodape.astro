---
import { Image } from "astro:assets";
import logo from "../assets/marca/logo-enactus-brasil-footer.svg";
import ListaLinks from "./ListaLinks.astro";
---

<footer>
  <div class="marca">
    <Image src={logo} alt="Enactus Brasil" height={48} />
    <p>Projeto de extensão da UCB em parceria com o Enactus UCB</p>
    <p class="creditos">
      Site feito pela equipe SocialTech, de estudantes da UCB
    </p>
  </div>
  <ListaLinks />
  <p class="topo">
    <a href="#topo">Voltar ao topo</a>
  </p>
</footer>

<style>
  footer {
    display: grid;
    gap: calc(var(--espaco) * 1.5);
    border-top: 0.25rem solid var(--cor-destaque);
    padding: calc(var(--espaco) * 2.5) var(--recuo-lateral);
    background: var(--cor-escura);
    color: var(--cor-fundo);
  }

  img {
    width: auto;
    height: 3rem;
  }

  .marca p {
    max-width: 22rem;
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
  }

  .marca .creditos {
    margin-top: 0.25rem;
    font-size: 0.875rem;
  }

  /* ListaLinks é de outro componente: :global() aplica o estilo só dentro do rodapé. */
  footer :global(h2) {
    margin: 0 0 0.5rem;
    color: var(--cor-destaque);
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  footer :global(h2)::after {
    display: none;
  }

  footer :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  footer :global(a) {
    display: inline-flex;
    align-items: center;
    min-width: var(--alvo-toque);
    min-height: var(--alvo-toque);
    color: var(--cor-fundo);
    text-decoration: underline;
  }

  footer :global(a:focus-visible) {
    outline-color: var(--cor-destaque);
  }

  /* "#topo" (e não BASE_URL + "#topo") não recarrega a página de quem veio pelo QR
     com ?campaign=..., o que contaria o acesso duas vezes no GoatCounter. */
  .topo {
    margin: 0;
  }

  @media (min-width: 48rem) {
    footer {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .topo {
      grid-column: 1 / -1;
    }
  }
</style>
