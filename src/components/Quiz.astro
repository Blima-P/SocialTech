---
import { getCollection } from "astro:content";

const perguntas = (await getCollection("quiz")).sort(
  (a, b) => Number(a.id) - Number(b.id),
);
---

{perguntas.length > 0 && (
  <section id="quiz" aria-labelledby="titulo-quiz" data-quiz>
    <h2 id="titulo-quiz">Teste o que você aprendeu</h2>
    <noscript>
      <p>Para conferir as respostas, ative o JavaScript do navegador.</p>
    </noscript>
    <ol class="perguntas">
      {perguntas.map(({ id, data }, indice) => (
        <li>
          <fieldset data-pergunta data-correta={data.correta}>
            <legend>
              <span class="numero-pergunta" aria-hidden="true">
                {String(indice + 1).padStart(2, "0")}
              </span>
              <span>{data.pergunta}</span>
            </legend>
            {data.alternativas.map((alternativa, indice) => (
              <label>
                <input type="radio" name={`quiz-${id}`} value={indice + 1} />
                {alternativa}
              </label>
            ))}
            <button type="button" class="botao" data-responder hidden>
              Responder
            </button>
            {/* Só o aviso é lido sozinho (aria-live). O resultado e a explicação são
                lidos uma vez, quando o foco vai para o .feedback (T-26). */}
            <p class="aviso" aria-live="polite" data-aviso />
            <div class="feedback" tabindex="-1" data-feedback>
              <div class="resultado" data-resultado />
              <p class="explicacao" hidden data-explicacao>
                {data.explicacao}
              </p>
            </div>
          </fieldset>
        </li>
      ))}
    </ol>
    <div class="final" aria-live="polite">
      <p data-placar />
      <button type="button" class="botao" data-refazer hidden>
        Refazer
      </button>
    </div>
  </section>
)}

<script>
  // O quiz só ensina: nada é enviado nem guardado (Q-12).
  for (const quiz of document.querySelectorAll<HTMLElement>("[data-quiz]")) {
    const perguntas = [
      ...quiz.querySelectorAll<HTMLFieldSetElement>("[data-pergunta]"),
    ];
    const placar = quiz.querySelector<HTMLElement>("[data-placar]")!;
    const refazer = quiz.querySelector<HTMLButtonElement>("[data-refazer]")!;
    const acertos = new Map<HTMLFieldSetElement, boolean>();

    const mostrarResultado = (
      pergunta: HTMLFieldSetElement,
      acertou: boolean,
    ) => {
      const resultado =
        pergunta.querySelector<HTMLElement>("[data-resultado]")!;
      const simbolo = document.createElement("span");
      simbolo.setAttribute("aria-hidden", "true");
      simbolo.textContent = acertou ? "✓ " : "✕ ";
      const texto = document.createElement("p");
      texto.className = acertou ? "certo" : "errado";
      texto.append(simbolo, acertou ? "Certo." : "Errado.");
      resultado.replaceChildren(texto);
      pergunta.querySelector<HTMLElement>("[data-explicacao]")!.hidden = false;
      const feedback = pergunta.querySelector<HTMLElement>("[data-feedback]")!;
      feedback.classList.toggle("feedback--certo", acertou);
      feedback.classList.toggle("feedback--errado", !acertou);
      feedback.focus();
    };

    for (const pergunta of perguntas) {
      const responder =
        pergunta.querySelector<HTMLButtonElement>("[data-responder]")!;
      responder.hidden = false;
      responder.addEventListener("click", () => {
        const escolhida =
          pergunta.querySelector<HTMLInputElement>("input:checked");
        const aviso = pergunta.querySelector<HTMLElement>("[data-aviso]")!;
        if (!escolhida) {
          aviso.textContent = "Escolha uma alternativa.";
          return;
        }
        aviso.textContent = "";
        const acertou = escolhida.value === pergunta.dataset.correta;
        acertos.set(pergunta, acertou);
        for (const opcao of pergunta.querySelectorAll("input"))
          opcao.disabled = true;
        responder.hidden = true;
        mostrarResultado(pergunta, acertou);

        if (acertos.size === perguntas.length) {
          const total = [...acertos.values()].filter(Boolean).length;
          placar.textContent = `Você acertou ${total} de ${perguntas.length}.`;
          refazer.hidden = false;
        }
      });
    }

    refazer.addEventListener("click", () => {
      acertos.clear();
      for (const pergunta of perguntas) {
        for (const opcao of pergunta.querySelectorAll("input")) {
          opcao.disabled = false;
          opcao.checked = false;
        }
        pergunta
          .querySelector<HTMLElement>("[data-resultado]")!
          .replaceChildren();
        pergunta
          .querySelector<HTMLElement>("[data-feedback]")!
          .classList.remove("feedback--certo", "feedback--errado");
        pergunta.querySelector<HTMLElement>("[data-aviso]")!.textContent = "";
        pergunta.querySelector<HTMLElement>("[data-explicacao]")!.hidden = true;
        pergunta.querySelector<HTMLElement>("[data-responder]")!.hidden = false;
      }
      placar.textContent = "";
      refazer.hidden = true;
      perguntas[0]?.querySelector("input")?.focus();
    });
  }
</script>

<style>
  .perguntas {
    display: grid;
    gap: var(--espaco);
    max-width: var(--largura-conteudo);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  fieldset {
    margin: 0;
    border: 1px solid #d5d5d5;
    border-left: 0.25rem solid var(--cor-destaque);
    border-radius: calc(var(--raio) * 1.5);
    padding: var(--espaco);
    background: var(--cor-fundo);
    box-shadow: 0 0.25rem 1rem rgb(48 51 60 / 8%);
  }

  legend {
    display: flex;
    width: 100%;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    padding: 0 0.25rem 0 0;
    font-weight: 700;
  }

  .numero-pergunta {
    display: grid;
    flex: 0 0 2rem;
    min-height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: var(--cor-destaque);
    color: var(--cor-texto);
    font-size: 0.875rem;
    line-height: 1;
  }

  label {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-height: var(--alvo-toque);
    margin-top: 0.5rem;
    border: 1px solid #d5d5d5;
    border-radius: var(--raio);
    padding: 0.625rem 0.75rem;
    background: var(--cor-fundo);
    cursor: pointer;
  }

  label:has(input:checked) {
    border-color: var(--cor-escura);
    background: var(--cor-fundo-suave);
  }

  label:has(input:disabled) {
    cursor: default;
  }

  input {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0.125rem 0 0;
    accent-color: var(--cor-escura);
  }

  input:focus-visible {
    outline: 3px solid var(--cor-escura);
    outline-offset: 3px;
  }

  .botao {
    justify-content: center;
    margin-top: 0.75rem;
  }

  .botao:focus-visible {
    outline-color: var(--cor-escura);
  }

  @media (hover: hover) {
    label:hover {
      border-color: var(--cor-texto-suave);
      background: var(--cor-fundo-suave);
    }

    .botao:hover {
      background: var(--cor-texto-suave);
    }
  }

  .aviso {
    margin: 0.5rem 0 0;
    color: var(--cor-nao-pode);
    font-weight: 700;
  }

  /* A região do aviso fica sempre na página (para o leitor de tela), mas sem espaço quando vazia. */
  .aviso:empty {
    margin: 0;
  }

  .feedback:has(.resultado:not(:empty)) {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.75rem;
    border-left: 0.25rem solid var(--cor-texto-suave);
    border-radius: 0 var(--raio) var(--raio) 0;
    padding: 0.75rem;
    background: var(--cor-fundo-suave);
  }

  .feedback:has(.resultado:not(:empty)).feedback--certo {
    border-left-color: var(--cor-pode);
    background: var(--cor-pode-fundo);
  }

  .feedback:has(.resultado:not(:empty)).feedback--errado {
    border-left-color: var(--cor-nao-pode);
    background: var(--cor-nao-pode-fundo);
  }

  .resultado :global(p),
  .explicacao {
    margin: 0;
  }

  .feedback--certo :global(.certo) {
    color: var(--cor-pode);
    font-weight: 700;
  }

  .feedback--errado :global(.errado) {
    color: var(--cor-nao-pode);
    font-weight: 700;
  }

  .feedback:focus {
    outline: 3px solid var(--cor-escura);
    outline-offset: 3px;
  }

  .explicacao {
    color: var(--cor-texto);
  }

  .final:has([data-placar]:not(:empty)) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    max-width: var(--largura-conteudo);
    margin-top: var(--espaco);
    border-top: 0.25rem solid var(--cor-destaque);
    border-radius: var(--raio);
    padding: 0.75rem var(--espaco);
    background: var(--cor-fundo-suave);
  }

  .final p {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .final .botao {
    margin-top: 0;
  }

  @media (min-width: 48rem) {
    fieldset {
      padding: calc(var(--espaco) * 1.25);
    }

    legend {
      align-items: center;
      margin-bottom: var(--espaco);
      font-size: 1.125rem;
    }
  }
</style>
