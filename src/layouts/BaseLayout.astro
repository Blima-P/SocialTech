---
import "../styles/global.css";
import "../styles/animacoes.css";

// Código do site no GoatCounter (ADR-003). Não é segredo.
const CODIGO_GOATCOUNTER = "socialtech-ucb";

interface Props {
  title: string;
  description?: string;
  /** Página de erro (404): não é indexada pelo Google nem contada no GoatCounter. */
  erro?: boolean;
}

const { title, description, erro = false } = Astro.props;
const enderecoPagina = new URL(Astro.url.pathname, Astro.site);
// Prévia do link no WhatsApp e nas redes (Open Graph). A imagem fica em public/.
const imagemCompartilhar = new URL(
  `${import.meta.env.BASE_URL}compartilhar.png`,
  Astro.site,
);
const contarAcesso = import.meta.env.PROD && !erro;

// Dados estruturados (schema.org) para buscadores, só na página indexável.
// Texto fixo do layout; "<" escapado para o JSON não fechar a tag <script>.
const inicio = new URL(import.meta.env.BASE_URL, Astro.site).href;
const dadosEstruturados = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${inicio}#site`,
      url: inicio,
      name: "Compostagem Enactus UCB",
      description,
      inLanguage: "pt-BR",
      publisher: { "@id": `${inicio}#organizacao` },
    },
    {
      "@type": "Organization",
      "@id": `${inicio}#organizacao`,
      name: "Enactus UCB",
      url: inicio,
      logo: new URL(`${import.meta.env.BASE_URL}favicon.svg`, Astro.site).href,
      parentOrganization: {
        "@type": "CollegeOrUniversity",
        name: "Universidade Católica de Brasília",
      },
    },
  ],
}).replaceAll("<", "\\u003c");

// Scripts inline (is:inline). O Astro não calcula o hash deles para a CSP (RNF-14):
// o hash sai do mesmo texto que vai para a página, então nunca fica desatualizado.
// RF-17: aplica o tema escolhido antes de desenhar a página, sem piscar.
const scriptTema = `
try {
  const tema = localStorage.getItem("tema");
  if (tema === "claro" || tema === "escuro") {
    document.documentElement.dataset.tema = tema;
  }
} catch {
  // Sem acesso ao armazenamento: segue o tema do sistema.
}
`;
// GoatCounter: conta só a página e a origem da campanha (campaign, ref).
const scriptGoatcounter = `
window.goatcounter = {
  path: () => {
    const parametros = new URLSearchParams(window.location.search);
    const origem = new URLSearchParams();
    for (const chave of ["campaign", "ref"]) {
      const valor = parametros.get(chave);
      if (valor) origem.set(chave, valor);
    }
    const sufixo = origem.toString();
    return window.location.pathname + (sufixo ? "?" + sufixo : "");
  },
};
`;
const autorizar = async (codigo: string) => {
  const resumo = await crypto.subtle.digest(
    "SHA-256",
    new TextEncoder().encode(codigo),
  );
  const base64 = btoa(String.fromCharCode(...new Uint8Array(resumo)));
  Astro.csp?.insertScriptHash(`sha256-${base64}`);
};
await autorizar(scriptTema);
if (contarAcesso) await autorizar(scriptGoatcounter);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffc222" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <title>{title}</title>
    {erro ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={enderecoPagina} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Compostagem Enactus UCB" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {!erro && <meta property="og:url" content={enderecoPagina} />}
    <meta property="og:image" content={imagemCompartilhar} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Compostagem Enactus UCB: descarte correto de resíduos orgânicos. Projeto de extensão UCB + Enactus."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {/* Fica no body: o Astro põe a CSP no fim do head, e todo script precisa vir depois dela. */}
    {/* eslint-disable-next-line astro/no-set-html-directive -- texto fixo do próprio layout, sem entrada externa; o set:html garante que o hash da CSP é do mesmo texto */}
    <script is:inline set:html={scriptTema} />
    {/* Bloco de dados, não é executado: a CSP de script não se aplica a ele. */}
    {/* eslint-disable astro/no-set-html-directive -- JSON fixo do próprio layout, com "<" escapado */}
    {!erro && (
      <script
        is:inline
        type="application/ld+json"
        set:html={dadosEstruturados}
      />
    )}
    {/* eslint-enable astro/no-set-html-directive */}
    <slot />
    {/* Contagem de acessos sem cookies, só no site publicado (ADR-003). */}
    {contarAcesso && (
      <>
        {/* eslint-disable-next-line astro/no-set-html-directive -- texto fixo do próprio layout, sem entrada externa; o set:html garante que o hash da CSP é do mesmo texto */}
        <script is:inline set:html={scriptGoatcounter} />
        <script
          is:inline
          async
          data-goatcounter={`https://${CODIGO_GOATCOUNTER}.goatcounter.com/count`}
          src="https://gc.zgo.at/count.js"
        ></script>
      </>
    )}
  </body>
</html>
